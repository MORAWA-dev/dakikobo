# Defense in depth for Apache/shared hosting where this repository may be
# placed below public_html. Prefer a DocumentRoot that contains only static
# public files and proxy requests to Gunicorn.
Options -Indexes

<FilesMatch "(^\.|\.env(?:\..*)?$|^(?:Dockerfile|Procfile|requirements\.txt|config\.py|app\.py)$|\.(?:py|pyc|sqlite3?|log|lock|ya?ml|toml)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "^(?:\.git|\.venv|venv|env|core|Data|data|tests)(?:/|$)" - [R=404,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
