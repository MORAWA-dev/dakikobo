# Virtual environment — never commit this
dakikobo_env/
venv/
.venv/
env/

# Secret keys (the web process uses server-level environment variables)
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Frontend test dependencies and local pnpm cache
node_modules/
.pnpm-store/

# Generated audio files (TTS output)
static/audio/*.mp3
# Partial TTS writes, if a synthesis is killed before the atomic rename.
static/audio/.tts-*

# ChromaDB persisted data (if you switch to persistent storage later)
chroma_db/
chroma_db*.lock

# User feedback/case logs (runtime-generated)
data/feedback.csv
data/case_log.sqlite3
data/case_log.sqlite3-*
data/runtime_state.sqlite3
data/runtime_state.sqlite3-*
data/feedback_images/

# Rejected / unverified generated research — never commit, never ingest.
# Model-gathered data that returned fabricated results; kept locally only.
Data/_archive/

# Firecrawl raw candidates stay local until reviewed/promoted.
Data/scraped/pending/*.md
!Data/scraped/pending/.gitkeep

# macOS junk
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Generated evaluation reports
reports/feedback_eval.csv
reports/feedback_eval.jsonl
reports/FEEDBACK_EVAL_PRIVACY.md
reports/source_refresh_log.md
# reports/rag_eval_results.md and reports/trusted_source_health.md are tracked
# on purpose: they are the dated review evidence for live RAG behaviour and
# trusted-source reachability, regenerated and committed at each review pass.

# Local planning docs with prompts (optional — remove line to track)
# suggestions/

# Private / large vision samples
Data/vision_eval/samples/

# Private session identity and journal mutation locks
data/.session_secret
data/*.mutations.lock

# Local review workspace (downloaded source PDFs, never committed)
tmp/

# Generated headless-browser rehearsal artifacts (screenshots, results, logs).
# Produced by tests/browser_replay_check.py under a per-run subdirectory and
# uploaded by CI on failure; never committed. The dated accessibility markdown
# report is kept on purpose as human review evidence.
reports/browser_replay_check/*.png
reports/browser_replay_check/results.json
reports/browser_replay_check/fixture.log
reports/browser_replay_check/error.json
# Per-invocation run directories (run-*, and any CI-supplied run id dirs).
reports/browser_replay_check/*/
