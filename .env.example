# Local shell-variable template only. The web process does not load .env files.
# Export these values in your shell for local work. In production, configure
# them in the hosting provider's secret/environment settings.

# --- Required ---
GROQ_API_KEY=your_groq_api_key_here

# --- Optional: leaf disease screening (Gemini Vision) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional: offline candidate source scraping (Firecrawl) ---
# Firecrawl output must be reviewed before promotion into active RAG.
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Optional overrides (defaults in config.py are fine for dev) ---
# Groq retired llama-3.3-70b-versatile on 2026-08-16; gpt-oss-120b is the
# replacement. Alternative: qwen/qwen3.6-27b (use LLM_REASONING_EFFORT=none).
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_RETRIES=1
# Keep reasoning out of farmer-facing answers: hidden | parsed | raw
# LLM_REASONING_FORMAT=hidden
# gpt-oss: low | medium | high. qwen3: none | default
# LLM_REASONING_EFFORT=low
# GROQ_USER_AGENT=Mozilla/5.0 DakiKobo/1.0
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=fr
# STT_TIMEOUT_SECONDS=30.0
# STT_MAX_RETRIES=1
# MAX_AUDIO_UPLOAD_MB=5.0
# TTS_CACHE_TTL_SECONDS=86400
# TTS_PARTIAL_TTL_SECONDS=3600
# TTS_CACHE_MAX_BYTES=67108864
# GEMINI_TIMEOUT_SECONDS=45.0
# WEATHER_TIMEOUT_SECONDS=10.0
# SOIL_TIMEOUT_SECONDS=18.0
# Shared SQLite cache/metrics state (runtime-generated and git-ignored)
# STATE_DB_PATH=data/runtime_state.sqlite3
# ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_TTL_SECONDS=86400
# CASE_LOG_DB_PATH=data/case_log.sqlite3
# FOLLOW_UP_DELAY_DAYS=7
# JOURNAL_RETENTION_DAYS=90
# JOURNAL_MAX_CASES=100
# FEEDBACK_IMAGE_DIR=data/feedback_images
# Shared request budgets across workers (raw client addresses are not stored)
# BUDGET_CLIENT_PER_MINUTE=60
# BUDGET_GLOBAL_PER_MINUTE=120
# BUDGET_GLOBAL_PER_DAY=2000
# WEB_FETCH_TIMEOUT_SECONDS=15.0
# FIRECRAWL_HTTP_TIMEOUT_SECONDS=45.0
# FIRECRAWL_SCRAPE_TIMEOUT_MS=60000
# FIRECRAWL_MAX_RETRIES=2

# --- Flask ---
# APP_ENV=development
# FLASK_DEBUG=false
# Set this explicitly in production, or persist STATE_DB_PATH's directory so
# the generated private session secret remains stable across restarts.
# FLASK_SECRET_KEY=a-strong-random-string
# Keep demo/private deployments out of search results unless public indexing is
# an explicit product decision.
# SEARCH_ENGINE_INDEXING_ENABLED=false
